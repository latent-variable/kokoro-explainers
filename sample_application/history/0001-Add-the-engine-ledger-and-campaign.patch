diff --git a/src/campaign.mjs b/src/campaign.mjs
new file mode 100644
index 0000000..a9af2de
--- /dev/null
+++ b/src/campaign.mjs
@@ -0,0 +1,4 @@
+// A campaign has a daily budget in cents.
+export function campaign({ id, name, dailyBudget }) {
+  return { id, name, dailyBudget };
+}
diff --git a/src/engine.mjs b/src/engine.mjs
new file mode 100644
index 0000000..538a522
--- /dev/null
+++ b/src/engine.mjs
@@ -0,0 +1,9 @@
+// Serve one impression: bill the campaign what the exchange charged.
+export function createEngine({ ledger }) {
+  return {
+    serve(campaign, event) {
+      ledger.record(campaign.id, event.costUsdCents);
+      return { served: true };
+    },
+  };
+}
diff --git a/src/ledger.mjs b/src/ledger.mjs
new file mode 100644
index 0000000..6bf31fa
--- /dev/null
+++ b/src/ledger.mjs
@@ -0,0 +1,12 @@
+// Spend so far today, per campaign, in USD cents: what the exchange bills us in.
+export function createLedger() {
+  const spent = new Map();
+  return {
+    record(campaignId, usdCents) {
+      spent.set(campaignId, (spent.get(campaignId) ?? 0) + usdCents);
+    },
+    spent(campaignId) {
+      return spent.get(campaignId) ?? 0;
+    },
+  };
+}
diff --git a/test/engine.test.mjs b/test/engine.test.mjs
new file mode 100644
index 0000000..bcdc304
--- /dev/null
+++ b/test/engine.test.mjs
@@ -0,0 +1,13 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { campaign } from "../src/campaign.mjs";
+import { createEngine } from "../src/engine.mjs";
+import { createLedger } from "../src/ledger.mjs";
+
+test("serving an impression bills the campaign", () => {
+  const ledger = createLedger();
+  const engine = createEngine({ ledger });
+  const c = campaign({ id: "c1", name: "Spring sale", dailyBudget: 10000 });
+  assert.deepEqual(engine.serve(c, { costUsdCents: 7 }), { served: true });
+  assert.equal(ledger.spent("c1"), 7);
+});
