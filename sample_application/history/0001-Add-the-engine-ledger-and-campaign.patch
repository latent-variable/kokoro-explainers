diff --git a/package.json b/package.json
new file mode 100644
index 0000000..4d807f8
--- /dev/null
+++ b/package.json
@@ -0,0 +1,10 @@
+{
+  "name": "pacer-demo",
+  "private": true,
+  "type": "module",
+  "description": "A toy ad-spend pacer: the kind of service an adtech portfolio company runs. Written for the ShipShow demo.",
+  "scripts": {
