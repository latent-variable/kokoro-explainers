Subject: [PATCH 3/5] Batch ledger writes

---
 src/ledger.mjs       | 27 +++++++++++++++++++++++----
 test/engine.test.mjs |  2 +-
 test/ledger.test.mjs | 16 ++++++++++++++++
 test/pacing.test.mjs |  4 ++--
 4 files changed, 42 insertions(+), 7 deletions(-)
 create mode 100644 test/ledger.test.mjs

diff --git a/src/ledger.mjs b/src/ledger.mjs
index 6bf31fa..8dc1d39 100644
--- a/src/ledger.mjs
+++ b/src/ledger.mjs
@@ -1,12 +1,31 @@
 // Spend so far today, per campaign, in USD cents: what the exchange bills us in.
-export function createLedger() {
-  const spent = new Map();
+// Writes are batched: the database is hit once per `flushEvery` records, not once per impression.
+// spent() reads what has been flushed.
+export const FLUSH_EVERY = 500;
+
+export function createLedger({ flushEvery = FLUSH_EVERY } = {}) {
+  const flushed = new Map();
+  let buffer = [];
+  let writes = 0;
+
+  function flush() {
+    if (!buffer.length) return;
+    for (const [id, cents] of buffer) flushed.set(id, (flushed.get(id) ?? 0) + cents);
+    buffer = [];
+    writes++;
+  }
+
   return {
     record(campaignId, usdCents) {
-      spent.set(campaignId, (spent.get(campaignId) ?? 0) + usdCents);
+      buffer.push([campaignId, usdCents]);
+      if (buffer.length >= flushEvery) flush();
     },
     spent(campaignId) {
-      return spent.get(campaignId) ?? 0;
+      return flushed.get(campaignId) ?? 0;
+    },
+    flush,
+    get writes() {
+      return writes;
     },
   };
 }
diff --git a/test/engine.test.mjs b/test/engine.test.mjs
index bcdc304..1c5fec9 100644
--- a/test/engine.test.mjs
+++ b/test/engine.test.mjs
@@ -5,7 +5,7 @@ import { createEngine } from "../src/engine.mjs";
 import { createLedger } from "../src/ledger.mjs";
 
 test("serving an impression bills the campaign", () => {
-  const ledger = createLedger();
+  const ledger = createLedger({ flushEvery: 1 });
   const engine = createEngine({ ledger });
   const c = campaign({ id: "c1", name: "Spring sale", dailyBudget: 10000 });
   assert.deepEqual(engine.serve(c, { costUsdCents: 7 }), { served: true });
diff --git a/test/ledger.test.mjs b/test/ledger.test.mjs
new file mode 100644
index 0000000..d831990
--- /dev/null
+++ b/test/ledger.test.mjs
@@ -0,0 +1,16 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { createLedger } from "../src/ledger.mjs";
+
+test("totals match what was recorded once the buffer is flushed", () => {
+  const ledger = createLedger();
+  for (let i = 0; i < 1200; i++) ledger.record("c1", 3);
+  ledger.flush();
+  assert.equal(ledger.spent("c1"), 3600);
+});
+
+test("the database is written once per 500 records, not once per impression", () => {
+  const ledger = createLedger();
+  for (let i = 0; i < 1500; i++) ledger.record("c1", 1);
+  assert.equal(ledger.writes, 3);
+});
